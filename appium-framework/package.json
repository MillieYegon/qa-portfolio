{
  "name": "appium-wdio-framework",
  "version": "1.0.0",
  "description": "Appium + WebdriverIO framework for a React Native app: local devices and BrowserStack from the same specs",
  "scripts": {
    "app:download": "bash scripts/download-app.sh",
    "test:android": "mkdir -p reports/failures && wdio run config/wdio.android.conf.ts",
    "test:smoke": "GREP=@smoke npm run test:android",
    "test:browserstack": "wdio run config/wdio.browserstack.conf.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@wdio/appium-service": "^9.15.0",
    "@wdio/browserstack-service": "^9.15.0",
    "@wdio/cli": "^9.15.0",
    "@wdio/junit-reporter": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.3",
    "typescript": "^5.7.2",
    "webdriverio": "^9.15.0"
  },
  "private": true
}
